/* ══════════════════════════════════════
   IDCA KOTA BEKASI — PORTFOLIO WEBSITE
   Modern Dark Theme
   ══════════════════════════════════════ */

:root {
  --bg: #0a0e1a;
  --bg2: #111827;
  --surface: #1a2035;
  --surface2: #212b45;
  --border: #2a3555;
  --text: #f1f5f9;
  --text2: #cbd5e1;
  --text3: #94a3b8;
  --accent: #3b82f6;
  --accent2: #60a5fa;
  --gold: #f59e0b;
  --red: #ef4444;
  --green: #22c55e;
  --gradient1: linear-gradient(135deg, #1e3a5f 0%, #0d1b2a 100%);
  --gradient2: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
  --radius: 12px;
  --radius-lg: 20px;
}

* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  font-family: 'Inter', sans-serif;
  background: var(--bg);
  color: var(--text);
  overflow-x: hidden;
  line-height: 1.6;
}

/* ═══ CONTAINER ═══ */
.container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 48px;
}

/* ═══ SPLASH SCREEN ═══ */
#splash {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  transition: opacity 0.8s ease, visibility 0.8s ease;
}
#splash.hidden {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}
.splash-content {
  text-align: center;
  animation: splashReveal 1.2s ease-out;
}
@keyframes splashReveal {
  0% { opacity: 0; transform: translateY(30px); }
  100% { opacity: 1; transform: translateY(0); }
}
.splash-logo {
  margin-bottom: 1rem;
}
.logo-drum {
  font-size: 4rem;
  display: inline-block;
  animation: drumBeat 1.5s ease-in-out infinite;
}
@keyframes drumBeat {
  0%, 100% { transform: rotate(-5deg) scale(1); }
  50% { transform: rotate(5deg) scale(1.05); }
}
.splash-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(3rem, 10vw, 6rem);
  font-weight: 900;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  background: var(--gradient2);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 0.2rem;
  line-height: 1.1;
}
.splash-sub {
  display: block;
  font-size: clamp(1rem, 3vw, 1.8rem);
  font-weight: 300;
  color: var(--text2);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  margin-bottom: 0.5rem;
}
.splash-tagline {
  font-size: 1rem;
  color: var(--text3);
  letter-spacing: 0.15em;
  text-transform: uppercase;
  margin-bottom: 2.5rem;
}
.splash-loader {
  display: flex;
  gap: 8px;
  justify-content: center;
}
.loader-ring {
  width: 12px;
  height: 12px;
  border: 2px solid var(--border);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}
.loader-ring:nth-child(2) { animation-delay: 0.15s; }
.loader-ring:nth-child(3) { animation-delay: 0.3s; }
@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ═══ NAVBAR ═══ */
.navbar {
  position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
  padding: 0 24px;
  background: rgba(10, 14, 26, 0.8);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid transparent;
  transition: all 0.3s ease;
}
.navbar.scrolled {
  background: rgba(10, 14, 26, 0.95);
  border-bottom-color: var(--border);
}
.nav-container {
  max-width: 1200px; margin: 0 auto;
  display: flex; align-items: center; justify-content: space-between;
  height: 70px;
}
.nav-logo {
  display: flex; align-items: center; gap: 10px;
  text-decoration: none; color: var(--text);
}
.logo-icon { 
  display: flex;
  align-items: center;
}
.logo-icon svg {
  width: 28px;
  height: 28px;
  color: var(--accent2);
}
.logo-text { display: flex; flex-direction: column; line-height: 1.2; }
.logo-main { font-size: 1.1rem; font-weight: 800; letter-spacing: 0.1em; }
.logo-sub { font-size: 0.65rem; color: var(--text3); letter-spacing: 0.05em; }
.nav-links {
  display: flex; list-style: none; gap: 8px;
}
.nav-links a {
  color: var(--text3); text-decoration: none;
  padding: 8px 16px; border-radius: 8px;
  font-size: 0.9rem; font-weight: 500;
  transition: all 0.2s ease;
}
.nav-links a:hover, .nav-links a.active {
  color: var(--text); background: var(--surface);
}
.nav-toggle {
  display: none; background: none; border: none; cursor: pointer;
  flex-direction: column; gap: 5px; padding: 8px;
}
.nav-toggle span {
  display: block; width: 24px; height: 2px;
  background: var(--text); border-radius: 2px;
  transition: all 0.3s ease;
}

/* ═══ HERO ═══ */
.hero {
  min-height: 100vh; display: flex; flex-direction: column;
  justify-content: center; align-items: center;
  position: relative; overflow: hidden;
  padding: 140px 64px 100px;
}
.hero-overlay {
  position: absolute; inset: 0;
  background: radial-gradient(ellipse at 30% 50%, rgba(59,130,246,0.15) 0%, transparent 60%),
              radial-gradient(ellipse at 70% 80%, rgba(245,158,11,0.08) 0%, transparent 50%);
}
.hero-bg-pattern {
  position: absolute; inset: 0;
  background-image: 
    radial-gradient(circle at 20% 30%, rgba(59,130,246,0.05) 0%, transparent 50%),
    radial-gradient(circle at 80% 70%, rgba(245,158,11,0.05) 0%, transparent 50%);
  background-size: 100% 100%;
}
.hero-content {
  position: relative; z-index: 1; text-align: center; max-width: 800px;
}
.hero-badge {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 8px 20px; border-radius: 50px;
  background: var(--surface); border: 1px solid var(--border);
  font-size: 0.85rem; color: var(--text3); margin-bottom: 32px;
}
.badge-dot {
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--green); animation: pulse 2s infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}
.hero-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2.5rem, 7vw, 5rem);
  font-weight: 900; line-height: 1.1;
  margin-bottom: 24px;
}
.title-line { display: block; }
.title-accent {
  background: var(--gradient2);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
}
.title-location {
  display: block; font-family: 'Inter', sans-serif;
  font-size: clamp(1rem, 3vw, 1.5rem);
  font-weight: 300; color: var(--text3);
  letter-spacing: 0.3em; text-transform: uppercase;
  margin-top: 8px;
}
.hero-desc {
  font-size: 1.1rem; color: var(--text3);
  max-width: 600px; margin: 0 auto 40px;
  line-height: 1.8;
}
.hero-actions {
  display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;
  margin-bottom: 60px;
}
.hero-stats {
  display: flex; gap: 40px; justify-content: center; flex-wrap: wrap;
}
.stat-item {
  display: flex; flex-direction: column; align-items: center; gap: 8px;
}
.stat-icon {
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  background: var(--surface);
  border: 1px solid var(--border);
  color: var(--accent2);
}
.stat-icon svg {
  width: 24px;
  height: 24px;
}
.stat-number { 
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--text);
}
.stat-label { font-size: 0.75rem; color: var(--text3); text-transform: uppercase; letter-spacing: 0.1em; }
.hero-scroll {
  position: absolute; bottom: 40px; left: 50%; transform: translateX(-50%);
  display: flex; flex-direction: column; align-items: center; gap: 8px;
  color: var(--text3); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.2em;
}
.scroll-line {
  width: 1px; height: 40px; background: var(--border);
  animation: scrollDown 2s infinite;
}
@keyframes scrollDown {
  0% { transform: scaleY(0); transform-origin: top; }
  50% { transform: scaleY(1); transform-origin: top; }
  51% { transform: scaleY(1); transform-origin: bottom; }
  100% { transform: scaleY(0); transform-origin: bottom; }
}

/* ═══ BUTTONS ═══ */
.btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 14px 28px; border-radius: 10px;
  font-size: 0.95rem; font-weight: 600;
  text-decoration: none; cursor: pointer; border: none;
  transition: all 0.3s ease;
}
.btn-primary {
  background: var(--gradient2); color: white;
  box-shadow: 0 4px 20px rgba(59,130,246,0.3);
}
.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(59,130,246,0.4); }
.btn-outline {
  background: transparent; color: var(--text);
  border: 1px solid var(--border);
}
.btn-outline:hover { background: var(--surface); border-color: var(--accent); }
.btn-sm { padding: 8px 16px; font-size: 0.85rem; border-radius: 8px; }

/* ═══ SECTIONS ═══ */
section { padding: 120px 0; }
.section-header { text-align: center; margin-bottom: 80px; }
.section-tag {
  display: inline-block; padding: 6px 16px;
  background: var(--surface); border: 1px solid var(--border);
  border-radius: 50px; font-size: 0.8rem; color: var(--accent2);
  text-transform: uppercase; letter-spacing: 0.15em; margin-bottom: 16px;
}
.section-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 800; line-height: 1.2;
}
.title-highlight {
  background: var(--gradient2);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* ═══ ABOUT ═══ */
.about-grid {
  display: grid; grid-template-columns: 1.5fr 1fr; gap: 60px; align-items: start;
}
.about-text p {
  color: var(--text2); font-size: 1.1rem; line-height: 2;
  margin-bottom: 20px;
}
.about-text strong { color: var(--accent2); }
.about-info { display: flex; flex-direction: column; gap: 16px; }
.info-card {
  display: flex; align-items: center; gap: 16px;
  padding: 20px; background: var(--surface);
  border-radius: var(--radius); border: 1px solid var(--border);
  transition: all 0.3s ease;
}
.info-card:hover { border-color: var(--accent); transform: translateX(4px); }
.info-icon { 
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  color: var(--accent2);
}
.info-icon svg {
  width: 24px;
  height: 24px;
}
.info-content h4 { font-size: 0.9rem; color: var(--text); margin-bottom: 2px; }
.info-content p { font-size: 0.85rem; color: var(--text3); }

/* ═══ STRUCTURE ═══ */
.structure { background: var(--bg2); }
.structure-placeholder {
  text-align: center; padding: 80px 40px;
  background: var(--surface); border-radius: var(--radius-lg);
  border: 1px solid var(--border); border-style: dashed;
}
.placeholder-icon { 
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.placeholder-icon svg {
  width: 64px;
  height: 64px;
  color: var(--accent2);
}
.structure-placeholder h3 {
  font-size: 1.5rem; color: var(--text); margin-bottom: 12px;
}
.structure-placeholder p {
  color: var(--text3); margin-bottom: 24px; max-width: 400px; margin-inline: auto;
}

/* ═══ ACTIVITIES ═══ */
.activities-grid {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 24px;
}
.activity-card {
  padding: 40px; background: var(--surface);
  border-radius: var(--radius); border: 1px solid var(--border);
  transition: all 0.3s ease;
}
.activity-card:hover {
  border-color: var(--accent); transform: translateY(-4px);
  box-shadow: 0 20px 40px rgba(0,0,0,0.3);
}
.activity-icon { 
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56px;
  height: 56px;
  border-radius: 12px;
  background: var(--surface2);
  color: var(--accent2);
  margin-bottom: 16px;
}
.activity-icon svg {
  width: 28px;
  height: 28px;
}
.activity-card h3 {
  font-size: 1.15rem; margin-bottom: 8px; color: var(--text);
}
.activity-card p { font-size: 0.9rem; color: var(--text3); line-height: 1.7; }

/* ═══ GALLERY ═══ */
.gallery { background: var(--bg2); }
.gallery-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 16px; margin-bottom: 40px;
}
.gallery-item {
  position: relative; border-radius: var(--radius);
  overflow: hidden; cursor: pointer;
  aspect-ratio: 4/3;
}
.gallery-item img,
.gallery-item video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
  display: block;
}
.gallery-item:hover img,
.gallery-item:hover video { transform: scale(1.05); }
/* Video portrait 9:16 — jangan di-crop, tampilkan utuh dengan letterbox hitam */
.gallery-item--video { background: #000; }
.gallery-item--video video { object-fit: contain; }
.gallery-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 60%);
  display: flex; align-items: flex-end; padding: 20px;
  opacity: 0; transition: opacity 0.3s ease;
}
.gallery-item:hover .gallery-overlay { opacity: 1; }
.gallery-overlay span {
  font-size: 0.9rem; color: white; font-weight: 500;
}
.gallery-cta {
  text-align: center;
}
.gallery-cta p { color: var(--text3); margin-bottom: 16px; }

/* ═══ LIGHTBOX ═══ */
.lightbox {
  display: none; position: fixed; inset: 0; z-index: 2000;
  background: rgba(0,0,0,0.95);
  justify-content: center; align-items: center;
}
.lightbox.active { display: flex; }
.lightbox-content {
  position: relative; max-width: 900px; width: 90%; text-align: center;
}
.lightbox-image {
  width: 100%; border-radius: var(--radius); margin-bottom: 16px;
  background: #000;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
}
.lightbox-image img,
.lightbox-image video {
  width: 100%; max-height: 70vh; object-fit: contain; display: block;
}
.lightbox-caption { color: var(--text3); font-size: 1rem; }
.lightbox-close {
  position: absolute; top: -40px; right: 0;
  background: none; border: none; color: white;
  font-size: 1.5rem; cursor: pointer;
}
.lightbox-nav {
  position: absolute; top: 50%; left: -60px; right: auto;
  transform: translateY(-50%); display: flex; gap: 8px;
}
.lb-btn {
  width: 44px; height: 44px; border-radius: 50%;
  background: var(--surface); border: 1px solid var(--border);
  color: white; font-size: 1.2rem; cursor: pointer;
  transition: all 0.2s ease;
}
.lb-btn:hover { background: var(--accent); }

/* ═══ CONTACT ═══ */
.contact-grid {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 24px;
}
.contact-card {
  text-align: center; padding: 48px 32px;
  background: var(--surface); border-radius: var(--radius-lg);
  border: 1px solid var(--border);
  transition: all 0.3s ease;
}
.contact-card:hover { border-color: var(--accent); transform: translateY(-4px); }
.contact-icon { 
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64px;
  height: 64px;
  margin: 0 auto 16px;
  border-radius: 16px;
  background: var(--surface2);
  color: var(--accent2);
}
.contact-icon svg {
  width: 32px;
  height: 32px;
}
.contact-card h3 { font-size: 1.1rem; margin-bottom: 8px; }
.contact-card p { color: var(--text3); font-size: 0.9rem; margin-bottom: 16px; }

/* ═══ FOOTER ═══ */
.footer {
  background: var(--bg2); padding: 80px 0 40px;
  border-top: 1px solid var(--border);
}
.footer-top {
  display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 40px;
  margin-bottom: 40px;
}
.footer-brand {}
.footer-logo {
  display: flex; align-items: center; gap: 12px; margin-bottom: 16px;
}
.footer-logo-main { font-size: 1.2rem; font-weight: 800; }
.footer-logo-sub { font-size: 0.7rem; color: var(--text3); }
.footer-desc { color: var(--text3); font-size: 0.9rem; line-height: 1.7; max-width: 300px; }
.footer-links h4 {
  font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em;
  color: var(--text); margin-bottom: 16px;
}
.footer-links a {
  display: block; color: var(--text3); text-decoration: none;
  font-size: 0.9rem; padding: 4px 0; transition: color 0.2s;
}
.footer-links a:hover { color: var(--accent2); }
.footer-bottom {
  border-top: 1px solid var(--border); padding-top: 24px;
  text-align: center; color: var(--text3); font-size: 0.85rem;
}
.footer-social {
  display: flex;
  gap: 12px;
  margin-top: 20px;
}
.footer-social a {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background: var(--surface);
  border: 1px solid var(--border);
  color: var(--text3);
  transition: all 0.2s ease;
  text-decoration: none;
}
.footer-social a:hover {
  background: var(--accent);
  border-color: var(--accent);
  color: white;
}
.footer-social a svg {
  width: 20px;
  height: 20px;
}

/* ═══ ANIMATIONS ═══ */
[data-animate] {
  opacity: 0; transform: translateY(30px);
  transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}
[data-animate].visible {
  opacity: 1; transform: translateY(0);
}

/* ═══ UNITS ═══ */
.units { background: var(--bg2); }
.units-grid {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 24px; margin-bottom: 40px;
}
.unit-card {
  padding: 36px; background: var(--surface);
  border-radius: var(--radius-lg); border: 1px solid var(--border);
  transition: all 0.3s ease; position: relative; overflow: hidden;
}
.unit-card::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
  background: var(--gradient2); opacity: 0; transition: opacity 0.3s;
}
.unit-card:hover { border-color: var(--accent); transform: translateY(-4px); }
.unit-card:hover::before { opacity: 1; }
.unit-badge {
  display: inline-block; padding: 4px 12px; border-radius: 50px;
  background: var(--accent); color: white; font-size: 0.7rem;
  font-weight: 700; letter-spacing: 0.1em; margin-bottom: 12px;
}
.unit-icon { 
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56px;
  height: 56px;
  border-radius: 12px;
  background: var(--surface2);
  color: var(--accent2);
  margin-bottom: 12px;
}
.unit-icon svg {
  width: 28px;
  height: 28px;
}
.unit-card h3 { font-size: 1.05rem; margin-bottom: 4px; }
.unit-school { color: var(--accent2); font-size: 0.85rem; margin-bottom: 8px; }
.unit-desc { color: var(--text3); font-size: 0.85rem; line-height: 1.6; margin-bottom: 12px; }
.unit-tags { display: flex; gap: 6px; flex-wrap: wrap; }
.tag {
  padding: 3px 10px; border-radius: 50px; font-size: 0.7rem;
  background: var(--surface2); color: var(--text3); border: 1px solid var(--border);
}
.units-cta {
  text-align: center; padding: 32px;
  background: var(--surface); border-radius: var(--radius-lg);
  border: 1px dashed var(--border);
}
.units-cta p { color: var(--text3); margin-bottom: 16px; }

/* ═══ ACHIEVEMENTS / TIMELINE ═══ */
.achievements {}
.timeline {
  position: relative; max-width: 800px; margin: 0 auto;
  padding-left: 40px;
}
.timeline::before {
  content: ''; position: absolute; left: 15px; top: 0; bottom: 0;
  width: 2px; background: var(--border);
}
.timeline-item {
  position: relative; padding-bottom: 32px;
}
.timeline-item:last-child { padding-bottom: 0; }
.timeline-dot {
  position: absolute; left: -33px; top: 4px;
  width: 12px; height: 12px; border-radius: 50%;
  background: var(--accent); border: 3px solid var(--bg);
  box-shadow: 0 0 0 2px var(--accent);
}
.timeline-content {
  padding: 28px 32px; background: var(--surface);
  border-radius: var(--radius); border: 1px solid var(--border);
  transition: all 0.3s ease;
}
.timeline-content:hover { border-color: var(--accent); }
.timeline-year {
  display: inline-block; padding: 3px 12px; border-radius: 50px;
  background: var(--gradient2); color: white;
  font-size: 0.75rem; font-weight: 700; margin-bottom: 8px;
}
.timeline-content h3 { font-size: 1rem; margin-bottom: 6px; }
.timeline-content p { font-size: 0.85rem; color: var(--text3); line-height: 1.6; }

/* ═══ VIDEOS ═══ */
.videos { background: var(--bg2); }
.videos-grid {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
  gap: 24px; margin-bottom: 32px;
}
.video-card {
  background: var(--surface); border-radius: var(--radius-lg);
  border: 1px solid var(--border); overflow: hidden;
  transition: all 0.3s ease;
}
.video-card:hover { border-color: var(--accent); transform: translateY(-4px); }
.video-wrapper {
  position: relative; padding-bottom: 56.25%; height: 0;
}
.video-wrapper iframe {
  position: absolute; inset: 0; width: 100%; height: 100%; border: 0;
}
.video-info { padding: 20px; }
.video-info h3 { font-size: 1rem; margin-bottom: 6px; }
.video-info p { font-size: 0.85rem; color: var(--text3); margin-bottom: 12px; }
.video-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--accent2);
  text-decoration: none;
  font-size: 0.85rem;
  font-weight: 500;
}
.video-link:hover { text-decoration: underline; }
.video-link svg {
  width: 16px;
  height: 16px;
}
.videos-cta { text-align: center; }
.videos-cta p { color: var(--text3); margin-bottom: 16px; }

/* ═══ PARTNERS ═══ */
.partners-grid {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 20px;
}
.partner-card {
  text-align: center; padding: 48px 32px;
  background: var(--surface); border-radius: var(--radius-lg);
  border: 1px solid var(--border); transition: all 0.3s ease;
}
.partner-card:hover { border-color: var(--accent); transform: translateY(-4px); }
.partner-icon { 
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64px;
  height: 64px;
  margin: 0 auto 16px;
  border-radius: 16px;
  background: var(--surface2);
  color: var(--accent2);
}
.partner-icon svg {
  width: 32px;
  height: 32px;
}
.partner-card h3 { font-size: 1.05rem; margin-bottom: 8px; }
.partner-card p { font-size: 0.85rem; color: var(--text3); line-height: 1.6; margin-bottom: 16px; }
.partner-link {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  color: var(--accent2);
  text-decoration: none;
  font-size: 0.85rem;
  font-weight: 500;
}
.partner-link:hover { text-decoration: underline; }
.partner-link svg {
  width: 14px;
  height: 14px;
}

/* ═══ FAQ ═══ */
.faq { background: var(--bg2); }
.faq-list { max-width: 800px; margin: 0 auto; }
.faq-item {
  margin-bottom: 12px; border: 1px solid var(--border);
  border-radius: var(--radius); overflow: hidden;
  background: var(--surface); transition: border-color 0.3s;
}
.faq-item:hover { border-color: var(--accent); }
.faq-question {
  width: 100%; display: flex; justify-content: space-between; align-items: center;
  padding: 18px 24px; background: none; border: none;
  color: var(--text); font-size: 0.95rem; font-weight: 600;
  cursor: pointer; text-align: left;
}
.faq-question:hover { color: var(--accent2); }
.faq-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  color: var(--accent);
  transition: transform 0.3s ease;
}
.faq-icon svg {
  width: 20px;
  height: 20px;
}
.faq-item.open .faq-icon { transform: rotate(180deg); }
.faq-answer {
  max-height: 0; overflow: hidden;
  transition: max-height 0.4s ease, padding 0.3s ease;
}
.faq-item.open .faq-answer {
  max-height: 300px; padding: 0 24px 18px;
}
.faq-answer p { color: var(--text3); font-size: 0.9rem; line-height: 1.7; }

/* ═══ CONTACT FORM ═══ */
.contact-form {
  max-width: 600px;
  margin: 40px auto 0;
  padding: 40px;
  background: var(--surface);
  border-radius: var(--radius-lg);
  border: 1px solid var(--border);
}
.form-group {
  margin-bottom: 20px;
}
.form-group label {
  display: block;
  font-size: 0.9rem;
  color: var(--text2);
  margin-bottom: 8px;
}
.form-group input,
.form-group textarea {
  width: 100%;
  padding: 12px 16px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--text);
  font-size: 1rem;
  font-family: inherit;
  transition: border-color 0.2s;
}
.form-group input:focus,
.form-group textarea:focus {
  outline: none;
  border-color: var(--accent);
}
.form-group textarea {
  min-height: 120px;
  resize: vertical;
}
.form-submit {
  display: flex;
  align-items: center;
  gap: 8px;
  justify-content: center;
  width: 100%;
  padding: 14px 28px;
  background: var(--gradient2);
  color: white;
  border: none;
  border-radius: var(--radius);
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
}
.form-submit:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 30px rgba(59,130,246,0.4);
}
.form-submit svg {
  width: 20px;
  height: 20px;
}
@media (max-width: 768px) {
  .nav-links {
    display: none; position: fixed; top: 70px; left: 0; right: 0;
    background: var(--bg); flex-direction: column; padding: 24px;
    border-bottom: 1px solid var(--border);
  }
  .nav-links.open { display: flex; }
  .nav-toggle { display: flex; }
  .about-grid { grid-template-columns: 1fr; gap: 48px; }
  .footer-top { grid-template-columns: 1fr; }
  .hero-stats { gap: 32px; }
  .timeline { padding-left: 36px; }
  .timeline-dot { left: -29px; }
  .videos-grid { grid-template-columns: 1fr; }
  .container { padding: 0 32px; }
}
.lightbox-nav { left: 10px; }
